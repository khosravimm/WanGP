[Unit]
Description=WanGP Community CPU Edition (Local Audio UI)
After=network.target moss-tts-nano-cpu.service
Wants=moss-tts-nano-cpu.service

[Service]
Type=simple
WorkingDirectory=/opt/Progs/WanGP-CPU-v19
ExecStart=/usr/bin/python3 /opt/Progs/WanGP-CPU-v19/wgp.py --cpu-only --host 127.0.0.1 --port 18084 --moss-url http://127.0.0.1:18083
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
